rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isTechnician() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/Technicians/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'Technician')
      );
    }
    
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/Admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'Admin')
      );
    }
    
    function isDeveloper() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/Developers/$(request.auth.uid));
    }
    
    function getUserOrganization() {
      return exists(/databases/$(database)/documents/Users/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.organization : '-';
    }
    
    function isJVAlmacisUser() {
      return getUserOrganization() == 'JV Almacis';
    }

    function hasRole(roles) {
      let userDoc = get(/databases/$(database)/documents/Users/$(request.auth.uid));
      return userDoc.data.role in roles;
    }

    // Organization that owns a given facility, used to scope the new
    // facility-scoped scope-of-work / preventive-maintenance subcollections.
    function facilityOrganization(facilityId) {
      return get(/databases/$(database)/documents/Facilities/$(facilityId)).data.organization;
    }

    function canAccessFacility(facilityId) {
      return isDeveloper() || isJVAlmacisUser() || facilityOrganization(facilityId) == getUserOrganization();
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Top-level records that name their facility (Work_Orders, BillingData, Reports, …). Uses the
    // field directly so list queries filtered by facilityId can be checked against it.
    function canAccessRecord(data) {
      return canAccessFacility(data.facilityId);
    }

    function facilityUnchanged() {
      return request.resource.data.facilityId == resource.data.facilityId;
    }

    // Uploaded documents (Reports, PriceList, Drawings, …): the uploader creates them for a facility
    // they can access; the uploader or an admin/developer edits or deletes them.
    function canCreateUpload() {
      return signedIn() && request.resource.data.userId == request.auth.uid &&
        canAccessRecord(request.resource.data);
    }

    function canManageUpload() {
      return signedIn() && canAccessRecord(resource.data) &&
        (resource.data.userId == request.auth.uid || isAdmin() || isDeveloper());
    }

    // The role/organization a user may give themselves on Users/{uid}: only what their Admins,
    // Developers or Technicians record says — records only admins/developers can write. Mirrors
    // RoleService._resolve in lib/providers/auth_providers.dart (Admin > Developer > Technician).
    function roleOrgBackedByRecord(uid, role, org) {
      let adminPath = /databases/$(database)/documents/Admins/$(uid);
      let techPath = /databases/$(database)/documents/Technicians/$(uid);
      let devPath = /databases/$(database)/documents/Developers/$(uid);
      return (exists(adminPath) && role == 'Admin' && org == get(adminPath).data.get('organization', '-')) ||
        (!exists(adminPath) && exists(devPath) && role == 'Technician' && org == 'JV Almacis') ||
        (!exists(adminPath) && !exists(devPath) && exists(techPath) && role == 'Technician' &&
          org == get(techPath).data.get('organization', '-'));
    }

    // 🔧 UPDATED: SystemNotifications collection rules - Enhanced for system updates
    match /SystemNotifications/{notificationId} {
      allow read: if request.auth != null; // All authenticated users can read system notifications
      allow create: if isDeveloper(); // Only developers can create system notifications
      allow update: if request.auth != null && (
        isDeveloper() || // Developers can update any field
        // Allow system/monitor updates for triggering notifications
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isTriggered', 'triggeredAt', 'status', 'triggerReason', 'triggeredBy',
          'sentCount', 'failedCount', 'lastSentAt', 'lastRetryAt', 'lastError', 'lastErrorAt'
        ]) ||
        // Allow users to update read status
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByUsers', 'status', 'lastReadAt'])
      );
      allow delete: if isDeveloper(); // Only developers can delete system notifications
    }

    // 🔧 UPDATED: CustomNotifications collection rules - Enhanced for system updates
    match /CustomNotifications/{notificationId} {
      allow read: if request.auth != null && (
        resource.data.organization == getUserOrganization() ||
        isDeveloper() ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        (request.resource.data.organization == getUserOrganization() && request.resource.data.createdBy == request.auth.uid) ||
        isDeveloper() ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        (resource.data.organization == getUserOrganization() &&
          (resource.data.createdBy == request.auth.uid || hasRole(['admin']))) ||
        isDeveloper() ||
        isAdmin() ||
        // 🔧 ENHANCED: Allow system/monitor updates for triggering notifications
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isTriggered', 'triggeredAt', 'status', 'triggerReason', 'triggeredBy',
          'sentCount', 'failedCount', 'lastSentAt', 'lastRetryAt', 'lastError', 'lastErrorAt'
        ]) ||
        // Allow users to update read status
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByUsers', 'status', 'lastReadAt'])
      );
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        isDeveloper() ||
        isAdmin()
      );
    }

    // Organizations collection rules
    match /Organizations/{organizationId} {
      allow read: if request.auth != null;
      // Was any admin; a client admin could edit other organizations.
      allow write: if isDeveloper() || (isAdmin() && isJVAlmacisUser());
    }

    // 🔧 UPDATED: Facilities collection rules with organization-based access
    match /Facilities/{facilityId} {
      allow read: if request.auth != null && (
        isDeveloper() || // Developers can read all facilities
        isJVAlmacisUser() || // JV Almacis users can read all facilities (service providers)
        (resource.data.organization == getUserOrganization() && getUserOrganization() != '-') || // Users can read facilities from their organization
        (getUserOrganization() == '-' && exists(/databases/$(database)/documents/Users/$(request.auth.uid))) // Allow read for new users without organization
      );
      allow write: if request.auth != null && (
        isDeveloper() || // Developers can create facilities for any organization
        (isJVAlmacisUser() && request.resource.data.keys().hasAll(['organization'])) || // JV Almacis users can create facilities with organization
        (!isJVAlmacisUser() && resource.data.organization == getUserOrganization()) // Other users can only create facilities for their organization
      );
      allow update: if request.auth != null && (
        isDeveloper() || // Developers can update any facility
        (isJVAlmacisUser()) || // JV Almacis users can update any facility (service providers)
        resource.data.organization == getUserOrganization() // Users can update facilities from their organization
      );
      allow delete: if request.auth != null && (
        isDeveloper() || // Developers can delete any facility
        (isAdmin() && (isJVAlmacisUser() || resource.data.organization == getUserOrganization())) // Admins can delete facilities they have access to
      );
    }

    // Users. role/organization drive isAdmin(), isTechnician() and organization scoping everywhere,
    // so users can no longer set them freely on their own profile (previously anyone could make
    // themselves Admin, or join "JV Almacis" and see every client's facilities).
    match /Users/{userId} {
      allow read: if isSelf(userId) || isDeveloper() || isAdmin() || isTechnician();

      // Sign-up (and the FCM-token upsert that can race it) creates an unassigned profile only.
      allow create: if isSelf(userId) &&
        request.resource.data.get('role', '-') == '-' &&
        request.resource.data.get('organization', '-') == '-';

      // Own profile edits are fine; role/organization may only move to what the user's
      // Admins/Developers/Technicians record says (the app's automatic role correction).
      allow update: if isSelf(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organization']) ||
        roleOrgBackedByRecord(userId, request.resource.data.get('role', '-'), request.resource.data.get('organization', '-'))
      );
      allow delete: if isSelf(userId);

      allow create, update, delete: if isDeveloper();

      // Admins assign roles. JV Almacis admins may assign anything; a client admin only manages
      // unassigned users or users of their own organization, and cannot grant Admin.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'username', 'email', 'organization', 'createdAt']) &&
        (isJVAlmacisUser() || (
          resource.data.get('organization', '-') in [getUserOrganization(), '-'] &&
          request.resource.data.get('organization', '-') in [getUserOrganization(), '-'] &&
          request.resource.data.get('role', '-') in ['Technician', 'User', '-']
        ));
    }

    match /Developers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isDeveloper();
      allow read: if isAdmin() || isTechnician();
      allow write: if isDeveloper();
      allow delete: if isDeveloper() &&
        get(/databases/$(database)/documents/Developers/$(userId)).data.email != 'lubangafabron@gmail.com';
    }

    match /Admins/{userId} {
      allow read: if isSelf(userId) || isDeveloper() || isAdmin() || isTechnician();
      // Was any admin, which let a client admin create a JV Almacis admin.
      allow write: if isDeveloper() || (isAdmin() && isJVAlmacisUser());
    }

    match /Technicians/{userId} {
      allow read: if signedIn();
      allow write: if isDeveloper() || (isAdmin() && isJVAlmacisUser());
      // Client admins add/remove technicians of their own organization only
      // (display screens/role_assignment_screen.dart writes the admin's organization).
      allow create, update: if isAdmin() &&
        request.resource.data.get('organization', '-') == getUserOrganization();
      allow delete: if isAdmin() && resource.data.get('organization', '-') == getUserOrganization();
    }

    match /admin_logs/{logId} {
      allow read, write, delete: if isDeveloper() || isAdmin();
    }

    // Uploaded documents: readable only by people with access to the record's facility (was: any
    // signed-in user, any organization). Deletes now work: the old `write` rule checked the new
    // document's userId, which a delete doesn't have, so every delete was refused.
    match /Reports/{reportId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if canCreateUpload();
      allow update: if canManageUpload() && facilityUnchanged();
      allow delete: if canManageUpload();
    }

    // Billing: JV Almacis admins upload and set payment status; the client organization's admin
    // approves. Previously any signed-in user could approve or reject any organization's billing.
    match /BillingData/{billingId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if canCreateUpload() && (isDeveloper() || (isAdmin() && isJVAlmacisUser()));
      allow update: if signedIn() && canAccessRecord(resource.data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'approvalNotes', 'approvedBy', 'approvedAt']) &&
          (isDeveloper() || (isAdmin() && facilityOrganization(resource.data.facilityId) == getUserOrganization()))) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          (isDeveloper() || (isAdmin() && isJVAlmacisUser())))
      );
      allow delete: if signedIn() && canAccessRecord(resource.data) &&
        (isDeveloper() || (isAdmin() && isJVAlmacisUser()));
    }

    match /BuildingSurveys/{surveyId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if canCreateUpload();
      allow update: if canManageUpload() && facilityUnchanged();
      allow delete: if canManageUpload();
    }

    match /Documentations/{documentationId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if canCreateUpload();
      allow update: if canManageUpload() && facilityUnchanged();
      allow delete: if canManageUpload();
    }

    match /Drawings/{drawingId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if canCreateUpload();
      allow update: if canManageUpload() && facilityUnchanged();
      allow delete: if canManageUpload();
    }

    match /PriceList/{priceListId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if canCreateUpload();
      allow update: if canManageUpload() && facilityUnchanged();
      allow delete: if canManageUpload();
    }

    match /Schedule_Maintenance/{scheduleId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow write: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isDeveloper() || isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isDeveloper() || isAdmin()
      );
    }

    // Requests and work orders are scoped to the facility's organization (was: readable by any
    // signed-in user, any organization). Who may change them is unchanged.
    match /Work_Requests/{requestId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid &&
        canAccessRecord(request.resource.data);
      allow update: if signedIn() && canAccessRecord(resource.data) && facilityUnchanged() && (
        resource.data.createdBy == request.auth.uid ||
        isDeveloper() || isAdmin() || isTechnician()
      );
      allow delete: if signedIn() && canAccessRecord(resource.data) && (
        resource.data.createdBy == request.auth.uid ||
        isDeveloper() || isAdmin()
      );
    }

    match /Work_Orders/{workOrderId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid &&
        canAccessRecord(request.resource.data);
      allow update: if signedIn() && canAccessRecord(resource.data) && facilityUnchanged() && (
        resource.data.createdBy == request.auth.uid ||
        isDeveloper() || isAdmin() || isTechnician()
      );
      allow delete: if signedIn() && canAccessRecord(resource.data) && (
        resource.data.createdBy == request.auth.uid ||
        isDeveloper() || isAdmin()
      );
    }

    // Legacy nested structure (keeping for backward compatibility)
    // Organization-scoped (was: any signed-in user, any facility).
    match /facilities/{facilityId}/requests/{requestId} {
      allow read, write: if signedIn() && canAccessFacility(facilityId);
    }

    match /facilities/{facilityId}/work_orders/{workOrderId} {
      allow read, write: if signedIn() && canAccessFacility(facilityId);
    }

    // Equipment is scoped to the facility's organization (was: any signed-in user, any facility).
    // Technicians still create/update (status changes, work-order history); only admins and
    // developers delete, since imported BIM records and their history would be lost.
    match /facilities/{facilityId}/equipment/{equipmentId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create, update: if request.auth != null && canAccessFacility(facilityId);
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    match /facilities/{facilityId}/inventory/{inventoryId} {
      allow read, write: if signedIn() && canAccessFacility(facilityId);
    }

    match /facilities/{facilityId}/assets/{assetId} {
      allow read, write: if signedIn() && canAccessFacility(facilityId);
    }

    // BIM: storeys/rooms and import records. Unlike the legacy blocks above, these are scoped to the
    // facility's organization via canAccessFacility(). Imports are an admin/developer action.
    match /facilities/{facilityId}/spaces/{spaceId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create, update: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    match /facilities/{facilityId}/bimModels/{modelId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper()) &&
        request.resource.data.uploadedBy == request.auth.uid;
      allow update: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    match /facilities/{facilityId}/bimSystems/{systemId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create, update: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    match /facilities/{facilityId}/bimContacts/{contactId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create, update: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    match /facilities/{facilityId}/bimSpares/{spareId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create, update: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    // 3D annotation pins placed by users in the BIM viewer.
    match /facilities/{facilityId}/bimAnnotations/{annotationId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create: if request.auth != null && canAccessFacility(facilityId) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && canAccessFacility(facilityId) &&
        (resource.data.createdBy == request.auth.uid || isAdmin() || isDeveloper());
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (resource.data.createdBy == request.auth.uid || isAdmin() || isDeveloper());
    }

    // Per-element 3D position overrides saved from the viewer's reposition tool.
    match /facilities/{facilityId}/bimElementOverrides/{globalId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow write: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    // Scope of Work documents uploaded per facility (Excel/PDF), plus the OCR/parsing
    // review queue nested underneath each document.
    match /facilities/{facilityId}/scope_of_work_documents/{docId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create: if request.auth != null && canAccessFacility(facilityId) &&
        request.resource.data.uploadedBy == request.auth.uid;
      allow update: if request.auth != null && (
        canAccessFacility(facilityId) &&
          (resource.data.uploadedBy == request.auth.uid || isAdmin() || isDeveloper()) ||
        // Allow the parsing Cloud Function (or client) to update status-only fields.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['parseStatus', 'parseError', 'startDate']
        )
      );
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (resource.data.uploadedBy == request.auth.uid || isAdmin() || isDeveloper());

      match /parsed_rows/{rowId} {
        allow read: if request.auth != null && canAccessFacility(facilityId);
        allow write: if request.auth != null && canAccessFacility(facilityId);
      }
    }

    // Facility-scoped preventive maintenance tasks (OCR-derived, manually added, or
    // migrated from the legacy global Maintenance_Tasks/TaskProgress collections).
    match /facilities/{facilityId}/preventive_maintenance/{taskId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create: if request.auth != null && canAccessFacility(facilityId);
      allow update: if request.auth != null && canAccessFacility(facilityId) && (
        isTechnician() || isAdmin() || isDeveloper() ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    // BIM-driven PM review queue: equipment with no default template, waiting for a
    // facility manager to either accept (create a custom PM task) or dismiss.
    // Admins, developers and technicians with facility access may read and manage it;
    // ordinary users (read-only role) may only read so the banner count is visible.
    match /facilities/{facilityId}/pm_review_queue/{itemId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper() || isTechnician());
      allow update: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper() || isTechnician());
      allow delete: if request.auth != null && canAccessFacility(facilityId) &&
        (isAdmin() || isDeveloper());
    }

    // Facility-scoped notifications generated from preventive_maintenance due dates — an
    // immutable audit record once written. System docs (type=='system') come only from Cloud
    // Functions via the Admin SDK, which bypasses these rules entirely; the create rule here only
    // needs to cover the client-authored path (a user creating a type=='custom' notification).
    match /facilities/{facilityId}/notifications/{notificationId} {
      allow read: if request.auth != null && canAccessFacility(facilityId);
      allow create: if request.auth != null && canAccessFacility(facilityId) &&
        request.resource.data.type == 'custom' && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && canAccessFacility(facilityId) && (isAdmin() || isDeveloper());
    }

    // Per-user notification digests (the consolidated notifications pipeline).
    // Each user only ever sees/touches their own subcollection; digest documents
    // themselves are Cloud-Function-only writes (admin SDK bypasses these rules),
    // clients may only patch their own read/delivery receipt fields.
    match /NotificationDigests/{userId}/items/{digestId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if false;
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'deliveredAt']);
      allow delete: if false;
    }

    // Per-run delivery audit log — which accounts/devices a given system or test notification
    // was actually sent to, and why any recipient was skipped or failed. Developer/admin only;
    // written exclusively by Cloud Functions (admin SDK bypasses rules).
    match /NotificationDeliveryLogs/{logId} {
      allow read: if isDeveloper() || isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Daily read/open engagement aggregates (counts and timings only — no notification content,
    // preserving the same privacy boundary as NotificationDigests above). Developer/admin only;
    // written exclusively by the aggregateNotificationEngagement Cloud Function.
    match /NotificationEngagementStats/{doc} {
      allow read: if isDeveloper() || isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Client-written proof-of-receipt: the moment a device actually gets a push (foreground or
    // native background handler), it upserts its own receipt here — separate from
    // NotificationDeliveryLogs (server-authoritative "FCM accepted it for delivery") so a
    // developer/admin can distinguish "we sent it" from "the device actually got it", without
    // widening read access to the full NotificationDigests content (task details, read status).
    // Doc id is `${runId}_${userId}`, so writes are naturally idempotent per device-run.
    match /NotificationDeliveryReceipts/{receiptId} {
      allow read: if isDeveloper() || isAdmin();
      allow create, update: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        receiptId == request.resource.data.runId + '_' + request.auth.uid;
      allow delete: if false;
    }

    match /maintenance_tasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
    }

    match /Maintenance_Tasks/{categoryId} {
      allow read, write, update, delete: if isDeveloper();
      allow read: if isTechnician() || isAdmin();
    }

    // 🔧 EXISTING: SystemSettings collection rules
    match /SystemSettings/{settingId} {
      allow read: if request.auth != null; // All authenticated users can read system settings
      allow write, update: if isDeveloper(); // Only developers can modify system settings
      allow delete: if isDeveloper();
    }

    // 🔧 FIXED: Enhanced Notifications rules (legacy collection)
    // Legacy collection: the app no longer writes it (Cloud Functions use the Admin SDK, which
    // bypasses rules). Writes were open to any signed-in user, allowing fake alerts.
    match /Notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if isDeveloper() || isAdmin();
    }

    // 🔧 UPDATED: TestNotifications rules - More permissive for testing
    match /TestNotifications/{testId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        isDeveloper() || isAdmin()
      );
    }

    // Was keyed on a Users.facilities list that nothing in the app writes, so technicians could not
    // read vendors and nobody could save one. Now scoped like other facility records: anyone with
    // access to the facility reads and logs service history; admins/developers add and remove.
    match /Vendors/{vendorId} {
      allow read: if signedIn() && canAccessRecord(resource.data);
      allow create: if signedIn() && canAccessRecord(request.resource.data) && (isAdmin() || isDeveloper());
      allow update: if signedIn() && canAccessRecord(resource.data) && facilityUnchanged();
      allow delete: if signedIn() && canAccessRecord(resource.data) && (isAdmin() || isDeveloper());
    }

    match /TaskProgress/{taskId} {
      allow read: if request.auth != null;
      allow write: if isDeveloper() || isTechnician() || isAdmin();
    }

    match /CategoryProgress/{categoryId} {
      allow read: if request.auth != null;
      allow write: if isDeveloper() || isTechnician() || isAdmin();
    }

    match /EmailNotifications/{emailId} {
      allow write: if request.auth != null;
      allow read: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
